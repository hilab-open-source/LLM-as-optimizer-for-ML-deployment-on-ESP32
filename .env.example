# Claude API (preferred): set this and the loop uses the official Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high          # low|medium|high|xhigh|max
# ANTHROPIC_MAX_TOKENS=16000

# Fallback: any OpenAI-compatible chat endpoint (used only if ANTHROPIC_API_KEY is unset)
# TOOLCHAIN_BASE_URL=https://llms.toolchain.ai
# TOOLCHAIN_API_KEY=your-key
# TOOLCHAIN_MODEL=claude-sonnet-4-6
# TOOLCHAIN_MAX_TOKENS=16000

# ESP32 board (see `arduino-cli board list`). Both can also be given as --port / --fqbn.
# ESP32_PORT=/dev/cu.usbserial-0001
# ESP32_FQBN=esp32:esp32:esp32       # ESP32-S3: esp32:esp32:esp32s3
